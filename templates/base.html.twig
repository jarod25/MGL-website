<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#070D0B">
    <link rel="icon" href="/images/branding/mgt-icon-white.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=League+Spartan:wght@600;700;800&display=swap" rel="stylesheet">
    <title>{% block title %}Mulhouse Gaming Tournament{% endblock %}</title>
    {% block stylesheets %}
        {% for file in encore_entry_css_files('main') %}
            <link rel="stylesheet" href="{{ preload(file, { as: 'style', importance: 'high' }) }}">
        {% endfor %}
    {% endblock %}
</head>
{% set currentRoute = app.request.attributes.get('_route')|default('') %}
{% set isAdminPage = currentRoute starts with 'app_admin_' %}
{% set isHomepage = currentRoute == 'app_home' %}
<body class="{{ isAdminPage ? 'mgt-admin' : 'mgt-public' }} {{ isHomepage ? 'mgt-page-home' : '' }}">
{% block content %}
    <div class="mgt-site-shell {{ isAdminPage ? '' : 'mgt-public-shell' }} {{ isHomepage ? 'mgt-home-shell' : '' }}">

    {% block navbar %}
        {% include 'partials/_navbar.html.twig' %}
    {% endblock %}

    <div class="top-10">
        {% include 'partials/_flash.html.twig' %}
    </div>

    <main class="container flex-grow-1">
        {% block body %}

        {% endblock %}
    </main>

    {% block footer %}
        {% include "partials/_footer.html.twig" %}
    {% endblock %}

    </div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('main') }}
{% endblock %}
</body>
</html>
