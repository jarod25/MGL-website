<!DOCTYPE html>
<html lang="{{ app.request ? app.request.locale : 'fr' }}">
<head>
    <meta charset="UTF-8">
    <title>{{ 'forgot_password.email.title'|trans }}</title>
</head>
<body style="margin:0;padding:0;background:#08111f;color:#f8f7ff;font-family:Arial,Helvetica,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#08111f;margin:0;padding:32px 12px;">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#11182a;border-radius:16px;border:1px solid #2a3146;">
                <tr>
                    <td style="padding:32px 28px;text-align:center;">
                        <h1 style="margin:0;color:#f8f7ff;font-size:28px;line-height:1.2;">{{ 'forgot_password.email.title'|trans }}</h1>
                        <p style="margin:8px 0 0;color:#e271a5;font-size:18px;font-weight:bold;">{{ 'forgot_password.email.subtitle'|trans }}</p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 28px 28px;color:#c8c4d8;font-size:16px;line-height:1.6;">
                        <p style="margin:0 0 18px;">{{ 'forgot_password.email.greeting'|trans({'%firstname%': user.firstname|default('')}) }}</p>
                        <p style="margin:0 0 20px;">{{ 'forgot_password.email.login_instruction'|trans }}</p>
                        <div style="background:#22162e;border:1px solid #e271a5;border-radius:12px;padding:20px;text-align:center;margin:0 0 20px;">
                            <div style="color:#c8c4d8;font-size:13px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px;">{{ 'forgot_password.email.temporary_password_label'|trans }}</div>
                            <div style="color:#f8f7ff;font-size:26px;font-weight:bold;letter-spacing:.08em;word-break:break-all;">{{ temporaryPassword }}</div>
                        </div>
                        <p style="margin:0 0 18px;color:#c8c4d8;">{{ 'forgot_password.email.security_note'|trans }}</p>
                        <p style="margin:24px 0 0;color:#f8f7ff;font-weight:bold;">{{ 'forgot_password.email.signature'|trans }}</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
