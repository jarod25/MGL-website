{% trans_default_domain 'homepage' %}

<section class="mgt-home-section">
    <div class="mgt-section-heading">
        <h2>{{ 'about_preview.title'|trans }}</h2>
    </div>

    <div class="mgt-about-preview">
        <div class="card-body d-flex flex-column gap-3 h-100">
            <p class="card-text mb-0">
                {{ 'about_preview.text'|trans }}
            </p>

            <div class="mt-auto">
                <a
                    class="btn btn-outline-primary"
                    href="{{ path('app_about') }}"
                >
                    {{ 'about_preview.link'|trans }}
                </a>
            </div>
        </div>
    </div>
</section>