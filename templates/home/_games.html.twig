{% trans_default_domain 'homepage' %}
<section class="py-4">
    <h2 class="h3 mb-3">{{ 'games.title'|trans }}</h2>
    <div class="row g-3">
        {% for game in games %}
            {% set descriptionKey = 'games.descriptions.' ~ game.slug %}
            {% set description = descriptionKey|trans %}
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h3 class="h5 card-title">{{ game.name }}</h3>
                        <p class="text-muted mb-2">{{ 'games.day'|trans({ '%day%': ('game.day.' ~ game.day.value)|trans({}, 'messages') }) }}</p>
                        <p class="card-text mb-0">{{ description == descriptionKey ? 'games.fallback_description'|trans : description }}</p>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12"><p class="text-muted">{{ 'games.empty'|trans }}</p></div>
        {% endfor %}
    </div>
</section>
