<section class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h3 mb-0">{{ 'home.games.title'|trans }}</h2>
        <a href="{{ path('app_team_index') }}" class="btn btn-sm btn-outline-primary">{{ 'home.games.all'|trans }}</a>
    </div>
    <div class="row g-3">
        {% for game in games %}
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h3 class="h5 card-title">{{ game.name }}</h3>
                        <p class="text-muted mb-2">{{ 'team.game.day'|trans({ '%day%': ('game.day.' ~ game.day.value)|trans }) }}</p>
                        <ul class="list-unstyled small mb-4">
                            <li>{{ 'team.game.players_per_team'|trans({ '%maxPlayers%': game.maxPlayersPerTeam }) }}</li>
                            <li>{{ 'team.game.max_teams'|trans({ '%maxTeams%': game.maxTeams }) }}</li>
                        </ul>
                        <a class="btn btn-primary mt-auto" href="{{ path('app_team_game', { slug: game.slug }) }}">{{ 'home.games.view_teams'|trans }}</a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12"><p class="text-muted">{{ 'home.games.empty'|trans }}</p></div>
        {% endfor %}
    </div>
</section>
