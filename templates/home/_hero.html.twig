{% trans_default_domain 'homepage' %}
<section class="mgt-hero mgt-pattern-panel" aria-labelledby="homepage-hero-title">
    <div class="mgt-hero__content">
        <div>
            <span class="mgt-eyebrow mb-3">{{ 'hero.badge'|trans }}</span>
            <h1 id="homepage-hero-title">{{ 'hero.title'|trans }}</h1>
            <p class="mgt-hero__meta mb-2">{{ 'hero.dates'|trans }}</p>
            <p class="fs-5 mb-1">{{ 'hero.place'|trans }}</p>
            <address class="text-muted mb-0">
                {{ 'hero.address_street'|trans }}<br>
                {{ 'hero.address_city'|trans }}
            </address>
            <div class="mgt-hero__actions mt-4">
                <a class="btn btn-primary mgt-hero__action" href="{{ path('app_registration_new') }}">{{ 'hero.register'|trans }}</a>
                <a class="btn btn-outline-primary mgt-hero__action" href="{{ path('app_team_index') }}">{{ 'hero.teams'|trans }}</a>
                <a class="btn btn-outline-secondary mgt-hero__action" href="{{ path('app_about') }}">{{ 'hero.about'|trans }}</a>
                <a class="btn btn-outline-secondary mgt-hero__action" href="{{ path('app_practical_information') }}">{{ 'hero.practical'|trans }}</a>
            </div>
        </div>
        <div class="mgt-hero__visual">
            {% if eventLogoExists %}<img
                class="mgt-hero__logo mb-4"
                src="/images/branding/mgt-logo-white.svg"
                alt="{{ 'hero.logo_alt'|trans }}"
                loading="lazy"
            >{% endif %}
            <div class="mgt-cash"><span class="mgt-cash__value">4 000 €</span><span class="mgt-cash__label">{{ 'hero.cash_prize'|trans }}</span></div>
        </div>
    </div>
</section>
