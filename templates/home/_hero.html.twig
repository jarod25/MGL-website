{% trans_default_domain 'homepage' %}
<section class="py-5 my-4 rounded-3 bg-light">
    <div class="container-fluid py-4 px-4 px-md-5">
        {% if eventLogoExists %}
            <img class="event-logo mb-3" src="{{ asset('images/branding/mgt-logo.svg') }}" alt="{{ 'hero.logo_alt'|trans }}" loading="lazy">
        {% endif %}
        <span class="badge text-bg-primary mb-3">{{ 'hero.badge'|trans }}</span>
        <h1 class="display-5 fw-bold">{{ 'hero.title'|trans }}</h1>
        <p class="fs-4 mb-2">{{ 'hero.dates'|trans }}</p>
        <p class="fs-5 mb-1">{{ 'hero.place'|trans }}</p>
        <p class="fs-5 fw-semibold mb-2">{{ 'hero.cash_prize'|trans }}</p>
        <address class="text-muted mb-0">{{ 'hero.address_name'|trans }}<br>{{ 'hero.address_street'|trans }}<br>{{ 'hero.address_city'|trans }}</address>
        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
            <a class="btn btn-primary btn-lg" href="{{ path('app_registration_new') }}">{{ 'hero.register'|trans }}</a>
            <a class="btn btn-outline-primary btn-lg" href="{{ path('app_team_index') }}">{{ 'hero.teams'|trans }}</a>
            <a class="btn btn-outline-secondary btn-lg" href="{{ path('app_about') }}">{{ 'hero.about'|trans }}</a>
            <a class="btn btn-outline-secondary btn-lg" href="{{ path('app_practical_information') }}">{{ 'hero.practical'|trans }}</a>
        </div>
    </div>
</section>
