{% extends 'base.html.twig' %}

{% block title %}{{ 'registration.pending.title'|trans }}{% endblock %}

{% block body %}
    <div class="py-4">
        <h1>{{ 'registration.pending.title'|trans }}</h1>
        <p>{{ 'registration.pending.message'|trans }}</p>
        <p>{{ 'registration.pending.reference'|trans({ '%reference%': participant.internalReference }) }}</p>
        {% if participant.registrationStatus == constant('App\\Enum\\RegistrationStatusEnum::PAID') %}
            <p>{{ 'registration.pending.status_paid'|trans }}</p>
            <a href="{{ path('app_team_index') }}" class="btn btn-primary">{{ 'registration.pending.go_to_teams'|trans }}</a>
        {% else %}
            <p>{{ 'registration.pending.status_pending'|trans }}</p>
        {% endif %}

        {% if not participant.isMajorConfirmed %}
            {% set parentalAuthorizationUrl = localized_document_url('parental_authorization', app.request.locale) %}
            <section class="mgt-panel mt-4">
                <div class="card-body">
                    <h2 class="h4 card-title">{{ 'lan_profile.documents.parental_authorization.title'|trans }}</h2>
                    <p>{{ 'lan_profile.documents.parental_authorization.message'|trans }}</p>
                    {% if parentalAuthorizationUrl %}
                        <a class="btn btn-outline-primary" href="{{ path('app_document_view', { type: 'parental_authorization' }) }}" target="_blank" rel="noopener noreferrer">{{ 'lan_profile.documents.parental_authorization.download'|trans }}</a>
                    {% else %}
                        <span class="badge bg-secondary">{{ 'documents.unavailable'|trans }}</span>
                    {% endif %}
                </div>
            </section>
        {% endif %}
    </div>
{% endblock %}
