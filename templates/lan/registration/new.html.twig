{% extends 'base.html.twig' %}

{% block title %}{{ 'registration.title'|trans }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1>{{ 'registration.title'|trans }}</h1>
        <p>{{ 'registration.payment_notice'|trans }}</p>

        {{ form_start(form) }}
        {{ form_row(form.firstname) }}
        {{ form_row(form.lastname) }}
        {{ form_row(form.email) }}
        {{ form_row(form.password) }}
        {{ form_row(form.discordPseudo) }}
        {{ form_row(form.isMajorConfirmed) }}
        <button class="btn btn-primary" type="submit">{{ 'registration.form.submit_payment'|trans }}</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
