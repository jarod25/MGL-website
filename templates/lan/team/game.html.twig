{% extends 'base.html.twig' %}

{% block title %}{{ 'team.game.page_title'|trans({ '%game%': game.name }) }}{% endblock %}

{% block body %}
    <div class="py-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_team_index') }}">{{ 'team.index.title'|trans }}</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ game.name }}</li>
            </ol>
        </nav>

        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
            <div>
                <h1>{{ 'team.game.heading'|trans({ '%game%': game.name }) }}</h1>
                <p class="text-muted mb-0">{{ ('event.date.' ~ game.day.value ~ '_full')|trans }}</p>
            </div>
            <a class="btn btn-primary" href="{{ path('app_team_new') }}">{{ 'team.index.create_link'|trans }}</a>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h6">{{ 'team.show.players'|trans }}</h2><p class="fs-5 mb-0">{{ 'team.game.players_per_team'|trans({ '%maxPlayers%': game.maxPlayersPerTeam }) }}</p></div></div></div>
            <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h6">{{ 'team.game.teams_capacity'|trans }}</h2><p class="fs-5 mb-0">{{ teamCount }} / {{ game.maxTeams }}</p></div></div></div>
            <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h6">{{ 'team.show.day'|trans }}</h2><p class="fs-5 mb-0">{{ ('game.day.' ~ game.day.value)|trans }}</p></div></div></div>
        </div>

        {% if teams is empty %}
            <div class="alert alert-info">
                <p class="mb-3">{{ 'team.game.empty'|trans({ '%game%': game.name }) }}</p>
                <a class="btn btn-primary" href="{{ path('app_team_new') }}">{{ 'team.index.create_link'|trans }}</a>
            </div>
        {% else %}
            <div class="list-group">
                {% for team in teams %}
                    <a class="list-group-item list-group-item-action d-flex flex-column flex-md-row justify-content-between gap-2" href="{{ path('app_team_show', { id: team.id }) }}">
                        <span class="fw-semibold">{{ team.name }}</span>
                        <span>{{ 'team.index.players_count'|trans({ '%count%': memberCounts[team.id]|default(0), '%max%': game.maxPlayersPerTeam }) }}</span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
