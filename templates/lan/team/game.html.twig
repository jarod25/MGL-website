{% extends 'base.html.twig' %}
{% trans_default_domain 'teams' %}
{% block title %}{{ 'game.page_title'|trans({ '%game%': game.name }) }}{% endblock %}
{% block body %}
<div class="mgt-public-page">
  <nav class="mgt-breadcrumb" aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('app_team_index') }}">{{ 'index.title'|trans }}</a></li><li class="breadcrumb-item active" aria-current="page">{{ game.name }}</li></ol></nav>
  <header class="mgt-page-header"><div class="mgt-page-header__row"><div><div class="mgt-section-heading"><h1>{{ 'game.heading'|trans({ '%game%': game.name }) }}</h1></div><p class="mgt-page-lead mb-0">{{ ('dates.' ~ game.day.value ~ '_full')|trans }}</p></div><a class="btn btn-primary" href="{{ path('app_team_new', { game: game.slug }) }}">{{ 'index.create_link'|trans }}</a></div></header>
  <div class="row g-3 mb-4"><div class="col-md-4"><div class="mgt-stat-panel h-100"><div class="mgt-stat-panel__label">{{ 'team.show.players'|trans({}, 'messages') }}</div><div class="mgt-stat-panel__value">{{ 'game.players_per_team'|trans({ '%maxPlayers%': game.maxPlayersPerTeam, '%count%': game.maxPlayersPerTeam }) }}</div></div></div><div class="col-md-4"><div class="mgt-stat-panel h-100"><div class="mgt-stat-panel__label">{{ 'game.teams_capacity'|trans }}</div><div class="mgt-stat-panel__value">{{ teamCount }} / {{ game.maxTeams }}</div></div></div><div class="col-md-4"><div class="mgt-stat-panel h-100"><div class="mgt-stat-panel__label">{{ 'team.show.day'|trans({}, 'messages') }}</div><div class="mgt-stat-panel__value">{{ ('game.day.' ~ game.day.value)|trans({}, 'messages') }}</div></div></div></div>
  {% if teams is empty %}<div class="mgt-panel mgt-empty-state"><p class="mb-3">{{ 'game.empty'|trans({ '%game%': game.name }) }}</p><a class="btn btn-primary" href="{{ path('app_team_new', { game: game.slug }) }}">{{ 'index.create_link'|trans }}</a></div>{% else %}<div class="mgt-list-panel">{% for team in teams %}<a class="mgt-team-row" href="{{ path('app_team_show_slug', { gameSlug: team.game.slug, teamSlug: team.slug }) }}"><span class="fw-semibold">{{ team.name }}</span><span class="mgt-counter">{{ 'index.players_count'|trans({ '%count%': memberCounts[team.id]|default(0), '%max%': game.maxPlayersPerTeam }) }}</span></a>{% endfor %}</div>{% endif %}
</div>
{% endblock %}
