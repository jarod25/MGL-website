{% extends 'base.html.twig' %}

{% block title %}{{ 'team.index.title'|trans }}{% endblock %}

{% block body %}
    <div class="py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1>{{ 'team.index.title'|trans }}</h1>
                <p class="text-muted mb-0">{{ 'team.index.subtitle'|trans }}</p>
            </div>
            <a class="btn btn-primary" href="{{ path('app_team_new') }}">{{ 'team.index.create_link'|trans }}</a>
        </div>

        {% if games is empty %}
            <p>{{ 'team.index.empty'|trans }}</p>
        {% endif %}

        <div class="row g-4">
            {% for game in games %}
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h2 class="h4 card-title">{{ game.name }}</h2>
                            <p class="text-muted">{{ ('event.date.' ~ game.day.value ~ '_full')|trans }}</p>
                            <ul class="list-group list-group-flush mb-4">
                                <li class="list-group-item px-0">{{ 'team.game.players_per_team'|trans({ '%maxPlayers%': game.maxPlayersPerTeam }) }}</li>
                                <li class="list-group-item px-0">{{ 'team.game.max_teams'|trans({ '%maxTeams%': game.maxTeams }) }}</li>
                                <li class="list-group-item px-0">{{ 'team.index.created_teams'|trans({ '%count%': teamCounts[game.id]|default(0) }) }}</li>
                            </ul>
                            <a class="btn btn-primary mt-auto" href="{{ path('app_team_game', { slug: game.slug }) }}">{{ 'team.index.view_teams'|trans }}</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
