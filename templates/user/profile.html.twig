{% extends 'base.html.twig' %}

{% block title %}{{ 'account.title'|trans }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">{{ 'account.title'|trans }}</h1>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white">
                        <h2 class="h5 mb-0">{{ 'account.info.title'|trans }}</h2>
                    </div>
                    <div class="card-body">
                        {{ form_start(form_infos) }}
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                {{ form_row(form_infos.firstname, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form_infos.lastname, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form_infos.email, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            {% if form_infos.discordPseudo is defined %}
                                <div class="col-12">
                                    {{ form_row(form_infos.discordPseudo, {'attr': {'class': 'form-control'}}) }}
                                </div>
                            {% elseif not hasLanParticipant %}
                                <div class="col-12">
                                    <p class="small text-muted mb-0">{{ 'account.form.discord_pseudo.participant_required'|trans }}</p>
                                </div>
                            {% endif %}
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">{{ 'account.form.submit_info'|trans }}</button>
                        </div>
                        {{ form_end(form_infos) }}
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white">
                        <h2 class="h5 mb-0">{{ 'account.password.title'|trans }}</h2>
                    </div>
                    <div class="card-body">
                        {{ form_start(form_pwd) }}
                        <div class="row g-3 mb-4">
                            <div class="col-12" data-controller="pwd-eye">
                                {{ form_row(form_pwd.oldPassword, {'attr': {'class': 'form-control', 'data-pwd-eye-target': 'input'}}) }}
                            </div>
                            <div class="col-12" data-controller="pwd-strength" data-pwd-strength-strength-value="4" data-pwd-strength-position-value="left">
                                <div data-controller="pwd-eye">
                                    {{ form_row(form_pwd.password.first, {'attr': {'class': 'form-control', 'data-pwd-eye-target': 'input', 'data-action': 'pwd-strength#handleInput'}}) }}
                                </div>
                                <div class="tips-popover"></div>
                            </div>
                            <div class="col-12" data-controller="pwd-eye">
                                {{ form_row(form_pwd.password.second, {'attr': {'class': 'form-control', 'data-pwd-eye-target': 'input'}}) }}
                            </div>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">{{ 'account.form.submit_password'|trans }}</button>
                        </div>
                        {{ form_end(form_pwd) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
