{% extends 'base.html.twig' %}

{% block title %}{{ 'forgot_password.title'|trans }}{% endblock %}

{% block body %}
    <div class="mgt-public-page mgt-auth-page mgt-auth-page--forgot-password">
        <div class="mgt-panel mgt-auth-panel">
            <div class="mgt-section-heading"><h1>{{ 'forgot_password.title'|trans }}</h1></div>
            <p class="mgt-auth-instructions mb-4">{{ 'forgot_password.instructions'|trans }}</p>

            {{ form_start(form) }}
                <div class="row g-3">
                    <div class="col-12">
                        <div class="form-floating">
                            {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'forgot_password.form.email.placeholder'|trans}}) }}
                            {{ form_label(form.email) }}
                        </div>
                        <div class="text-danger">{{ form_errors(form.email) }}</div>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary" type="submit">{{ 'forgot_password.submit'|trans }}</button>
                    </div>
                </div>
            {{ form_end(form) }}

            <div class="mgt-auth-footer">
                <a class="mgt-auth-secondary-link" href="{{ path('app_login') }}">{{ 'forgot_password.back_to_login'|trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}
