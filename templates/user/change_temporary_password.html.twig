{% extends 'base.html.twig' %}

{% block title %}{{ 'temporary_password.title'|trans }}{% endblock %}

{% block body %}
    <div class="mgt-public-page mgt-auth-page mgt-auth-page--temporary-password">
        <div class="mgt-panel mgt-auth-panel">
            <div class="mgt-section-heading"><h1>{{ 'temporary_password.title'|trans }}</h1></div>
            <p class="mgt-auth-instructions mb-4">{{ 'temporary_password.instructions'|trans }}</p>

            {{ form_start(form) }}
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <div class="form-floating" data-controller="pwd-eye">
                            {{ form_widget(form.oldPassword, {'attr': {'class': 'form-control', 'placeholder': 'account.password.current.placeholder'|trans, 'data-pwd-eye-target': 'input', 'autocomplete': 'current-password'}}) }}
                            {{ form_label(form.oldPassword) }}
                        </div>
                        <div class="text-danger">{{ form_errors(form.oldPassword) }}</div>
                    </div>
                    <div class="col-12" data-controller="pwd-strength"
                         data-pwd-strength-strength-value="{{ passwordStrength }}"
                         data-pwd-strength-position-value="left"
                         data-pwd-strength-title-value="{{ 'password_requirements.title'|trans }}"
                         data-pwd-strength-min-length-value="{{ 'password_requirements.min_length'|trans }}"
                         data-pwd-strength-lowercase-value="{{ 'password_requirements.lowercase'|trans }}"
                         data-pwd-strength-uppercase-value="{{ 'password_requirements.uppercase'|trans }}"
                         data-pwd-strength-numbers-value="{{ 'password_requirements.numbers'|trans }}"
                         data-pwd-strength-special-characters-value="{{ 'password_requirements.special_characters'|trans }}">
                        <div class="form-floating" data-controller="pwd-eye">
                            {{ form_widget(form.password.first, {'attr': {'class': 'form-control', 'placeholder': 'account.password.new.placeholder'|trans, 'data-pwd-eye-target': 'input', 'data-action': 'pwd-strength#handleInput', 'autocomplete': 'new-password'}}) }}
                            {{ form_label(form.password.first) }}
                        </div>
                        <div class="tips-popover"></div>
                        <div class="text-danger">{{ form_errors(form.password.first) }}{{ form_errors(form.password) }}</div>
                    </div>
                    <div class="col-12">
                        <div class="form-floating" data-controller="pwd-eye">
                            {{ form_widget(form.password.second, {'attr': {'class': 'form-control', 'placeholder': 'account.password.confirm.placeholder'|trans, 'data-pwd-eye-target': 'input', 'autocomplete': 'new-password'}}) }}
                            {{ form_label(form.password.second) }}
                        </div>
                        <div class="text-danger">{{ form_errors(form.password.second) }}</div>
                    </div>
                </div>
                <button class="btn btn-primary" type="submit">{{ 'temporary_password.submit'|trans }}</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
