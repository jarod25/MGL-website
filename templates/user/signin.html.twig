{% extends 'base.html.twig' %}

{% block title %}{{ 'signup.title'|trans }}{% endblock %}

{% block body %}
    <div class="mgt-public-page mgt-auth-page mgt-auth-page--narrow">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="mgt-panel mgt-auth-panel">
                    <div class="mgt-section-heading text-center"><h1>{{ 'signup.title'|trans }}</h1></div>
                    <div>
                        {{ form_start(form) }}
                        <div class="row g-3">
                            <div class="col-12">
                                {{ form_row(form.firstname, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form.lastname, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form.email, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <div class="col-12" data-controller="pwd-strength"
                                     data-pwd-strength-strength-value="4"
                                     data-pwd-strength-position-value="left"
                                     data-pwd-strength-title-value="{{ 'password_requirements.title'|trans }}"
                                     data-pwd-strength-min-length-value="{{ 'password_requirements.min_length'|trans }}"
                                     data-pwd-strength-lowercase-value="{{ 'password_requirements.lowercase'|trans }}"
                                     data-pwd-strength-uppercase-value="{{ 'password_requirements.uppercase'|trans }}"
                                     data-pwd-strength-numbers-value="{{ 'password_requirements.numbers'|trans }}"
                                     data-pwd-strength-special-characters-value="{{ 'password_requirements.special_characters'|trans }}">
                                <div data-controller="pwd-eye">
                                    {{ form_row(form.password.first, {'attr': {'class': 'form-control', 'data-pwd-eye-target': 'input', 'data-action': 'pwd-strength#handleInput'}}) }}
                                </div>
                                <div class="tips-popover"></div>
                            </div>
                            <div class="col-12" data-controller="pwd-eye">
                                {{ form_row(form.password.second, {'attr': {'class': 'form-control', 'data-pwd-eye-target': 'input'}}) }}
                            </div>
                            <div class="text-danger">
                                {{ form_errors(form) }}
                            </div>
                        </div>
                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary">{{ 'signup.submit'|trans }}</button>
                        </div>
                        {{ form_end(form) }}
                    </div>
                    <div class="mgt-auth-footer">
                        <span class="small">{{ 'signup.already_account'|trans }} <a href="{{ path('app_login') }}">{{ 'signup.login_link'|trans }}</a></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
