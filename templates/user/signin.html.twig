{% extends 'base.html.twig' %}

{% block title %}{{ 'signup.title'|trans }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white text-center">
                        <h1 class="h2 mb-0">{{ 'signup.title'|trans }}</h1>
                    </div>
                    <div class="card-body p-4">
                        {{ form_start(form) }}
                        <div class="row g-3">
                            <div class="col-12">
                                {{ form_row(form.firstname, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form.lastname, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form.email, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <div class="col-12" data-controller="pwd-strength" data-pwd-strength-strength-value="4" data-pwd-strength-position-value="left">
                                <div data-controller="pwd-eye">
                                    {{ form_row(form.password.first, {'attr': {'class': 'form-control', 'data-pwd-eye-target': 'input', 'data-action': 'pwd-strength#handleInput'}}) }}
                                </div>
                                <div class="tips-popover"></div>
                            </div>
                            <div class="col-12" data-controller="pwd-eye">
                                {{ form_row(form.password.second, {'attr': {'class': 'form-control', 'data-pwd-eye-target': 'input'}}) }}
                            </div>
                            <div class="text-danger">
                                {{ form_errors(form) }}
                            </div>
                        </div>
                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-lg btn-primary text-white">{{ 'signup.submit'|trans }}</button>
                        </div>
                        {{ form_end(form) }}
                    </div>
                    <div class="card-footer text-center">
                        <span class="small">{{ 'signup.already_account'|trans }} <a href="{{ path('app_login') }}">{{ 'signup.login_link'|trans }}</a></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
