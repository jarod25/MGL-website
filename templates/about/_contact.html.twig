{% trans_default_domain 'about' %}
<section class="mb-4">
    <div class="mgt-section-heading"><h2>{{ 'contact.title'|trans }}</h2></div>
    <div class="mgt-panel">
        <div class="mgt-panel-body d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center">
            <p class="mb-0">{{ 'contact.text'|trans }}</p>
            <a class="btn btn-primary" href="{{ path('app_contact') }}">{{ 'contact.link'|trans }}</a>
        </div>
    </div>
</section>
