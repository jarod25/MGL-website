{% trans_default_domain 'about' %}
<section class="mb-5">
    <div class="mgt-section-heading"><h2>{{ 'partners.title'|trans }}</h2></div>
    <div class="row g-3">
        {% for partner in partners %}
            <div class="col-12 col-md-6 col-lg-4">
                <div class="mgt-panel h-100 partner-card">
                    <div class="mgt-panel-body d-flex flex-column gap-3">
                        <div class="partner-card__logo-wrapper">
                            {% if partner.logoPath is defined %}
                                {% if partner.url is defined %}
                                    <a
                                        href="{{ partner.url }}"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                {% endif %}

                                <img
                                    class="partner-card__logo"
                                    src="{{ partner.logoPath }}"
                                    alt="{{ 'partners.logo_alt'|trans({ '%name%': partner.name }) }}"
                                    loading="lazy"
                                >

                                {% if partner.url is defined %}
                                    </a>
                                {% endif %}
                            {% else %}
                                <p class="h5 mb-0 text-center">{{ partner.name }}</p>
                            {% endif %}
                        </div>
                        <h3 class="h5 card-title mb-0">{{ partner.name }}</h3>
                        {% set descriptionKey = 'partners.descriptions.' ~ partner.key %}
                        {% set description = descriptionKey|trans %}
                        {% if description != descriptionKey %}<p class="mgt-panel-text mb-0">{{ description|raw }}</p>{% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</section>
