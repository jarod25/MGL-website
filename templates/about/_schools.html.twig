{% trans_default_domain 'about' %}
<section class="mb-5">
    <div class="mgt-section-heading"><h2>{{ 'schools.title'|trans }}</h2></div>
    <div class="mgt-panel mb-3">
        <div class="mgt-panel-body">
            <p class="mb-0">{{ 'schools.intro'|trans|raw }}</p>
        </div>
    </div>
    <div class="mgt-schools-grid">
        <article class="mgt-panel mgt-school-card">
            <div class="mgt-panel-body">
                <h3 class="mgt-panel-title h5">{{ 'schools.enscmu.title'|trans }}</h3>
                <p class="mgt-panel-text mb-3">{{ 'schools.enscmu.text'|trans }}</p>
                <a class="btn btn-outline-primary btn-sm" href="https://www.enscmu.uha.fr/" target="_blank" rel="noopener noreferrer">{{ 'schools.website_link'|trans }}</a>
            </div>
        </article>
        <article class="mgt-panel mgt-school-card">
            <div class="mgt-panel-body">
                <h3 class="mgt-panel-title h5">{{ 'schools.ensisa.title'|trans }}</h3>
                <p class="mgt-panel-text mb-3">{{ 'schools.ensisa.text'|trans }}</p>
                <a class="btn btn-outline-primary btn-sm" href="https://www.ensisa.uha.fr/" target="_blank" rel="noopener noreferrer">{{ 'schools.website_link'|trans }}</a>
            </div>
        </article>
        <article class="mgt-panel mgt-school-card">
            <div class="mgt-panel-body">
                <h3 class="mgt-panel-title h5">{{ 'schools.phg_academy.title'|trans }}</h3>
                <p class="mgt-panel-text mb-0">{{ 'schools.phg_academy.text'|trans }}</p>
            </div>
        </article>
    </div>
</section>
