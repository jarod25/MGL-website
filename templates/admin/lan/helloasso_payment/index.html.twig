{% extends 'base.html.twig' %}{% block title %}{{ 'helloasso_admin.title'|trans }}{% endblock %}{% block body %}<div class="mgt-public-page mgt-admin-page"><header class="mgt-page-header"><h1>{{ 'helloasso_admin.title'|trans }}</h1></header><form class="mgt-panel mgt-panel-body row g-2 mb-3"><div class="col-md-4"><input class="form-control" name="q" value="{{ filters.q|default('') }}" placeholder="{{ 'helloasso_admin.search'|trans }}"></div><div class="col-md-2"><input class="form-control" name="paymentState" value="{{ filters.paymentState|default('') }}" placeholder="{{ 'helloasso_admin.payment_state'|trans }}"></div><div class="col-md-3"><select class="form-select" name="matchStatus"><option value="">{{ 'helloasso_admin.match_status'|trans }}</option>{% for s in statuses %}<option value="{{ s.value }}" {{ filters.matchStatus|default('')==s.value?'selected' }}>{{ s.value }}</option>{% endfor %}</select></div><div class="col-md-2"><select class="form-select" name="association"><option value="">{{ 'helloasso_admin.association'|trans }}</option><option value="associated">{{ 'helloasso_admin.associated'|trans }}</option><option value="unassociated">{{ 'helloasso_admin.unassociated'|trans }}</option></select></div><div class="col-md-1"><button class="btn btn-primary">OK</button></div></form><div class="mgt-panel mgt-admin-table-panel"><table class="table mgt-admin-table"><thead><tr><th>{{ 'helloasso_admin.payment_id'|trans }}</th><th>{{ 'helloasso_admin.payer'|trans }}</th><th>{{ 'helloasso_admin.tier_id'|trans }}</th><th>{{ 'helloasso_admin.amount'|trans }}</th><th>{{ 'helloasso_admin.payment_state'|trans }}</th><th>{{ 'helloasso_admin.match_status'|trans }}</th><th>{{ 'helloasso_admin.received_at'|trans }}</th><th></th></tr></thead><tbody>{% for p in pagination %}<tr><td><code>{{ p.paymentId }}</code><br>{{ p.orderId }}</td><td>{{ p.payerFirstname }} {{ p.payerLastname }}<br><span class="text-muted">{{ p.payerEmail }}</span></td><td><code>{{ p.tierId ?: 'admin.common.not_available'|trans }}</code></td><td>{{ p.amount is not null ? (p.amount/100)|format_currency('EUR') : 'admin.common.not_available'|trans }}</td><td>{{ p.paymentState }}</td><td>{{ p.matchStatus.value }}</td><td>{{ p.receivedAt|date('d/m/Y H:i') }}</td><td><a class="btn btn-sm btn-primary" href="{{ path('app_admin_lan_helloasso_payment_show',{id:p.id}) }}">{{ 'helloasso_admin.view'|trans }}</a></td></tr>{% else %}<tr><td colspan="8">{{ 'admin.common.not_available'|trans }}</td></tr>{% endfor %}</tbody></table>{{ knp_pagination_render(pagination) }}</div></div>{% endblock %}
