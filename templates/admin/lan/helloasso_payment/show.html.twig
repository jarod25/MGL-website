{% extends 'base.html.twig' %}{% block title %}{{ 'helloasso_admin.title'|trans }}{% endblock %}{% block body %}<div class="mgt-public-page mgt-admin-page"><section class="mgt-panel"><div class="mgt-panel-body"><h1>{{ 'helloasso_admin.title'|trans }}</h1><dl class="row"><dt class="col-sm-4">{{ 'helloasso_admin.payment_id'|trans }}</dt><dd class="col-sm-8"><code>{{ payment.paymentId }}</code></dd><dt class="col-sm-4">{{ 'helloasso_admin.order_id'|trans }}</dt><dd class="col-sm-8">{{ payment.orderId ?: 'admin.common.not_available'|trans }}</dd><dt class="col-sm-4">{{ 'helloasso_admin.form'|trans }}</dt><dd class="col-sm-8">{{ payment.organizationSlug }} / {{ payment.formType }} / {{ payment.formSlug }}</dd><dt class="col-sm-4">{{ 'helloasso_admin.payer'|trans }}</dt><dd class="col-sm-8">{{ payment.payerFirstname }} {{ payment.payerLastname }} — {{ payment.payerEmail }}</dd><dt class="col-sm-4">{{ 'helloasso_admin.tier_id'|trans }}</dt><dd class="col-sm-8"><code>{{ payment.tierId ?: 'admin.common.not_available'|trans }}</code></dd><dt class="col-sm-4">{{ 'helloasso_admin.payment_state'|trans }}</dt><dd class="col-sm-8">{{ payment.paymentState }}</dd><dt class="col-sm-4">{{ 'helloasso_admin.match_status'|trans }}</dt><dd class="col-sm-8">{{ payment.matchStatus.value }}</dd><dt class="col-sm-4">{{ 'helloasso_admin.mismatch_reason'|trans }}</dt><dd class="col-sm-8">{{ payment.mismatchReason ?: 'admin.common.not_available'|trans }}</dd><dt class="col-sm-4">Participant</dt><dd class="col-sm-8">{{ payment.participant ? payment.participant.internalReference : 'admin.common.not_available'|trans }}</dd><dt class="col-sm-4">Subscription</dt><dd class="col-sm-8">{{ payment.subscription ? payment.subscription.name : 'admin.common.not_available'|trans }}</dd><dt class="col-sm-4">{{ 'helloasso_admin.receipt'|trans }}</dt><dd class="col-sm-8">{% if payment.receiptUrl %}<a href="{{ payment.receiptUrl }}" rel="noopener noreferrer" target="_blank">{{ 'helloasso_admin.receipt'|trans }}</a>{% else %}{{ 'admin.common.not_available'|trans }}{% endif %}</dd></dl><form method="post" action="{{ path('app_admin_lan_helloasso_payment_reconcile',{id:payment.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('reconcile_helloasso_payment_' ~ payment.id) }}"><button class="btn btn-primary">{{ 'helloasso_admin.reconcile'|trans }}</button></form></div></section></div>{% endblock %}
