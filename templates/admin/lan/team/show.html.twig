{% extends 'base.html.twig' %}
{% block title %}{{ 'admin.team.show_title'|trans({ '%name%': team.name }) }}{% endblock %}
{% block body %}<div class="mgt-public-page mgt-admin-page">
<header class="mgt-page-header"><div class="mgt-page-header__row"><div class="mgt-section-heading"><h1>{{ team.name }}</h1></div><div class="mgt-actions"><a class="btn btn-outline-primary" href="{{ path('app_admin_lan_team_index') }}">{{ 'admin.team.back'|trans }}</a><a class="btn btn-primary" href="{{ path('app_admin_lan_team_edit',{id:team.id}) }}">{{ 'admin.team.rename'|trans }}</a><a class="btn btn-primary" href="{{ path('app_admin_lan_team_member_new',{id:team.id}) }}">{{ 'admin.team.add_member'|trans }}</a></div></div></header>
<div class="row g-4"><div class="col-12 col-lg-5"><div class="mgt-panel h-100"><div class="mgt-panel-body"><h2 class="h5">{{ 'admin.team.details'|trans }}</h2><dl class="row mb-0"><dt class="col-sm-5">{{ 'admin.team.game'|trans }}</dt><dd class="col-sm-7">{{ team.game.name }}</dd><dt class="col-sm-5">{{ 'admin.team.day'|trans }}</dt><dd class="col-sm-7">{{ ('game.day.' ~ team.game.day.value)|trans }}</dd><dt class="col-sm-5">{{ 'admin.team.captain'|trans }}</dt><dd class="col-sm-7">{{ team.captain.firstname }} {{ team.captain.lastname }}</dd><dt class="col-sm-5">{{ 'admin.team.created_at'|trans }}</dt><dd class="col-sm-7">{{ team.createdAt|date('d/m/Y H:i') }}</dd><dt class="col-sm-5">{{ 'admin.team.members'|trans }}</dt><dd class="col-sm-7">{{ 'admin.team.members_count'|trans({ '%count%': memberCount, '%max%': maxPlayers }) }}</dd></dl></div></div></div><div class="col-12 col-lg-7"><div class="mgt-panel mgt-danger-panel h-100"><div class="mgt-panel-body"><h2 class="h5">{{ 'admin.team.delete.title'|trans }}</h2><p>{{ 'admin.team.delete.help'|trans }}</p><form method="post" action="{{ path('app_admin_lan_team_delete',{id:team.id}) }}" onsubmit="return confirm('{{ 'admin.team.delete.confirm'|trans|e('js') }}');"><input type="hidden" name="_token" value="{{ csrf_token('admin_delete_team_' ~ team.id) }}"><button class="btn btn-danger" type="submit">{{ 'admin.team.delete.submit'|trans }}</button></form></div></div></div></div>
<div class="mgt-panel mt-4"><div class="mgt-panel-body"><h2 class="h5">{{ 'admin.team.members'|trans }}</h2><div class="mgt-panel mgt-admin-table-panel"><div class="table-responsive"><table class="table align-middle mgt-admin-table"><thead><tr><th>{{ 'admin.participant.full_name'|trans }}</th><th>{{ 'admin.participant.email'|trans }}</th><th>{{ 'admin.participant.discord_pseudo'|trans }}</th><th>{{ 'team.show.in_game_pseudo'|trans }}</th><th>{{ 'admin.team.role'|trans }}</th><th>{{ 'admin.team.actions'|trans }}</th></tr></thead><tbody>{% for member in members %}{% set isCaptain = team.captain and member.participant and team.captain.id == member.participant.id %}<tr><td>{{ member.participant.firstname }} {{ member.participant.lastname }}</td><td>{{ member.participant.email }}</td><td>{{ member.participant.discordPseudo ?? 'admin.common.not_available'|trans }}</td><td>{{ member.inGamePseudo }}</td><td>{% if isCaptain %}<span class="badge text-bg-primary">{{ 'team.show.captain'|trans }}</span>{% else %}<span class="badge text-bg-secondary">{{ 'team.show.member'|trans }}</span>{% endif %}</td><td><div class="d-flex flex-wrap gap-2"><a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_lan_participant_show',{id:member.participant.id}) }}">{{ 'admin.team.participant_file'|trans }}</a><a class="btn btn-sm btn-primary" href="{{ path('app_admin_lan_team_member_edit',{teamId:team.id,memberId:member.id}) }}">{{ 'admin.team.edit_pseudo'|trans }}</a>{% if not isCaptain %}<form method="post" action="{{ path('app_admin_lan_team_member_delete',{teamId:team.id,memberId:member.id}) }}" onsubmit="return confirm('{{ 'admin.team.member.delete_confirm'|trans|e('js') }}');"><input type="hidden" name="_token" value="{{ csrf_token('admin_delete_team_member_' ~ member.id) }}"><button class="btn btn-sm btn-danger" type="submit">{{ 'admin.team.remove_member'|trans }}</button></form>{% endif %}</div></td></tr>{% endfor %}</tbody></table></div></div></div>
</div>
</div>
{% endblock %}
