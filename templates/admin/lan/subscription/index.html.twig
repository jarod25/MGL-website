{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.subscription.title'|trans }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
            <h1 class="mb-0">{{ 'admin.subscription.title'|trans }}</h1>
            <a class="btn btn-outline-secondary" href="{{ path('app_admin_lan_index') }}">{{ 'admin.subscription.back_to_admin'|trans }}</a>
        </div>
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                <tr>
                    <th>{{ 'admin.subscription.name'|trans }}</th>
                    <th>{{ 'admin.subscription.slug'|trans }}</th>
                    <th>{{ 'admin.subscription.price'|trans }}</th>
                    <th>{{ 'admin.subscription.duration'|trans }}</th>
                    <th>{{ 'admin.subscription.helloasso_tier_id'|trans }}</th>
                    <th>{{ 'admin.subscription.status'|trans }}</th>
                    <th>{{ 'admin.subscription.actions'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for subscription in subscriptions %}
                    <tr>
                        <td>{{ subscription.name }}</td>
                        <td><code>{{ subscription.slug }}</code></td>
                        <td>{{ (subscription.price / 100)|format_currency('EUR', {fraction_digit: 2}) }}</td>
                        <td>{{ 'admin.subscription.duration_days'|trans({ '%days%': subscription.durationDays }) }}</td>
                        <td>{{ subscription.helloAssoTierId ?? 'admin.common.not_available'|trans }}</td>
                        <td>
                            {% if subscription.active %}
                                <span class="badge text-bg-success">{{ 'admin.subscription.active'|trans }}</span>
                            {% else %}
                                <span class="badge text-bg-secondary">{{ 'admin.subscription.inactive'|trans }}</span>
                            {% endif %}
                        </td>
                        <td><a class="btn btn-sm btn-primary" href="{{ path('app_admin_lan_subscription_edit', { id: subscription.id }) }}">{{ 'admin.subscription.edit'|trans }}</a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
