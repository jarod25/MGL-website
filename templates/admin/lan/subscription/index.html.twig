{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.subscription.title'|trans }}{% endblock %}

{% block body %}
    <div class="mgt-public-page mgt-admin-page">
        <header class="mgt-page-header">
            <div class="mgt-page-header__row">
                <div class="mgt-section-heading"><h1>{{ 'admin.subscription.title'|trans }}</h1></div>
                <div class="mgt-actions"><a class="btn btn-outline-primary" href="{{ path('app_admin_lan_index') }}">{{ 'admin.subscription.back_to_admin'|trans }}</a></div>
            </div>
        </header>
        <div class="mgt-panel mgt-admin-table-panel"><div class="table-responsive"><table class="table align-middle mgt-admin-table"><thead><tr><th>{{ 'admin.subscription.name'|trans }}</th><th>{{ 'admin.subscription.slug'|trans }}</th><th>{{ 'admin.subscription.price'|trans }}</th><th>{{ 'admin.subscription.duration'|trans }}</th><th>{{ 'admin.subscription.helloasso_tier_id'|trans }}</th><th>{{ 'admin.subscription.status'|trans }}</th><th>{{ 'admin.subscription.actions'|trans }}</th></tr></thead><tbody>{% for subscription in subscriptions %}<tr><td>{{ subscription.name }}</td><td><code>{{ subscription.slug }}</code></td><td>{{ (subscription.price / 100)|format_currency('EUR', {fraction_digit: 2}) }}</td><td>{{ 'admin.subscription.duration_days'|trans({ '%days%': subscription.durationDays }) }}</td><td>{{ subscription.helloAssoTierId ?? 'admin.common.not_available'|trans }}</td><td>{% if subscription.active %}<span class="badge text-bg-success">{{ 'admin.subscription.active'|trans }}</span>{% else %}<span class="badge text-bg-secondary">{{ 'admin.subscription.inactive'|trans }}</span>{% endif %}</td><td><a class="btn btn-sm btn-primary" href="{{ path('app_admin_lan_subscription_edit', { id: subscription.id }) }}">{{ 'admin.subscription.edit'|trans }}</a></td></tr>{% else %}<tr><td colspan="7" class="mgt-admin-empty">{{ 'admin.common.not_available'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
    </div>
{% endblock %}
