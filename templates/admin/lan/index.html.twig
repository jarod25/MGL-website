{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.lan.title'|trans }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <h1 class="mb-0">{{ 'admin.lan.title'|trans }}</h1>
            <a class="btn btn-success" href="{{ path('app_admin_lan_participant_export') }}">{{ 'admin.participant.export.download'|trans }}</a>
        </div>
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <div class="card h-100"><div class="card-body d-flex flex-column gap-3">
                    <h2 class="h5 card-title mb-0">{{ 'admin.lan.subscriptions'|trans }}</h2>
                    <a class="btn btn-primary mt-auto" href="{{ path('app_admin_lan_subscription_index') }}">{{ 'admin.lan.subscriptions'|trans }}</a>
                </div></div>
            </div>
            <div class="col-12 col-md-6">
                <div class="card h-100"><div class="card-body d-flex flex-column gap-3">
                    <h2 class="h5 card-title mb-0">{{ 'admin.lan.participants'|trans }}</h2>
                    <a class="btn btn-primary mt-auto" href="{{ path('app_admin_lan_participant_index') }}">{{ 'admin.lan.participants'|trans }}</a>
                </div></div>
            </div>
            <div class="col-12 col-md-6">
                <div class="card h-100"><div class="card-body d-flex flex-column gap-3">
                    <h2 class="h5 card-title mb-0">{{ 'admin.lan.teams'|trans }}</h2>
                    <a class="btn btn-primary mt-auto" href="{{ path('app_admin_lan_team_index') }}">{{ 'admin.lan.teams'|trans }}</a>
                </div></div>
            </div>
        </div>
    </div>
{% endblock %}
