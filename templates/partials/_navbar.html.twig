<nav class="navbar navbar-expand-lg navbar-dark bg-dark text-white">
    <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="{{ 'navigation.toggle'|trans }}">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            {{ knp_menu_render('main') }}
            {% set currentLocale = app.request.locale %}
            {% set locales = {
                fr: { label: 'language.fr', flag: '/images/flags/fr.svg' },
                en: { label: 'language.en', flag: '/images/flags/en.svg' },
                de: { label: 'language.de', flag: '/images/flags/de.svg' }
            } %}
            <div class="navbar-user-area ms-auto d-flex flex-row flex-nowrap align-items-center justify-content-end gap-2 mt-2 mt-lg-0">
                <ul class="navbar-nav language-switcher flex-row flex-nowrap align-items-center gap-1 mb-0" aria-label="{{ 'navigation.language'|trans }}">
                    {% for locale, language in locales %}
                        <li class="nav-item language-switcher__item">
                            {% if locale == currentLocale %}
                                <span class="nav-link language-switcher__link language-switcher__link--active" aria-current="true" aria-disabled="true" title="{{ language.label|trans }}">
                                    <img class="language-switcher__flag" src="{{ language.flag }}" alt="{{ language.label|trans }}" width="24" height="16" loading="lazy">
                                </span>
                            {% else %}
                                <a class="nav-link language-switcher__link" href="{{ path('app_locale_switch', { locale: locale }) }}" title="{{ language.label|trans }}">
                                    <img class="language-switcher__flag" src="{{ language.flag }}" alt="{{ language.label|trans }}" width="24" height="16" loading="lazy">
                                </a>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
                <ul class="navbar-nav flex-row flex-nowrap align-items-center mb-0">
                    {% if app.user %}
                        <li class="nav-item dropdown account-menu">
                            <button class="nav-link dropdown-toggle account-menu__toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'navigation.account_menu'|trans }}" title="{{ 'navigation.account_menu'|trans }}">
                                <svg class="account-menu__icon" viewBox="0 0 24 24" role="img" aria-hidden="true" focusable="false">
                                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4Zm0 2c-3.31 0-6 1.79-6 4v1c0 .55.45 1 1 1h10c.55 0 1-.45 1-1v-1c0-2.21-2.69-4-6-4Z" fill="currentColor"/>
                                </svg>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="{{ path('app_profile') }}">{{ 'navigation.account'|trans }}</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_lan_profile') }}">{{ 'navigation.my_lan'|trans }}</a></li>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li><a class="dropdown-item" href="{{ path('app_admin_lan_index') }}">{{ 'admin.navigation'|trans }}</a></li>
                                {% endif %}
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="{{ path('app_logout') }}">{{ 'navigation.logout'|trans }}</a></li>
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link text-white navbar-action-link" href="{{ path('app_login') }}">{{ 'navigation.login_signup'|trans }}</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>
</nav>
