<footer class="footer bg-light py-3 mt-auto">
    <div class="container">
        <div class="row">
            <div class="col-md-12 text-center">
                {% if "now"|date("Y") == '2026' %}
                    <p>&copy; 2026 Mulhouse Gaming Tournament. {{ 'footer.all_right_reserved'|trans }}</p>
                {% else %}
                    <p>&copy; 2026 - {{ "now"|date("Y") }} Mulhouse Gaming Tournament.  {{ 'footer.all_right_reserved'|trans }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</footer>