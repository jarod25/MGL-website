{% extends 'base.html.twig' %}
{% trans_default_domain 'contact' %}
{% block title %}{{ 'meta.title'|trans }}{% endblock %}
{% block body %}
<div class="py-4">
    <h1>{{ 'title'|trans }}</h1>
    <p class="lead">{{ 'lead'|trans }}</p>
    <div class="card"><div class="card-body">
        <p class="mb-2"><strong>{{ 'email_label'|trans }}</strong> <a href="mailto:mulhousegaminglan@gmail.com">mulhousegaminglan@gmail.com</a></p>
        <p>{{ 'place'|trans }}</p>
        <div class="d-flex flex-column flex-sm-row gap-2">
            <a class="btn btn-primary" href="mailto:mulhousegaminglan@gmail.com">{{ 'mail_button'|trans }}</a>
            <a class="btn btn-outline-primary" href="{{ path('app_practical_information') }}">{{ 'practical_link'|trans }}</a>
        </div>
    </div></div>
</div>
{% endblock %}
